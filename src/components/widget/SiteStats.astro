---
import WidgetLayout from "@/components/common/WidgetLayout.astro";
import OnlineSiteStats from "@/components/widget/OnlineSiteStats.svelte";
import I18nKey from "@/i18n/i18nKey";
import { i18n } from "@/i18n/translation";
import { siteConfig } from "@/config/siteConfig";
import type { WidgetComponentConfig } from "@/types/config";

interface Props { class?: string; style?: string; widgetConfig?: WidgetComponentConfig }
const { class: className, style, widgetConfig } = Astro.props;
---

<WidgetLayout name={i18n(I18nKey.siteStats)} showTitle={widgetConfig?.showTitle !== false} id="site-stats" class={className} style={style}>
  <OnlineSiteStats client:visible siteStartDate={siteConfig.siteStartDate || "2026-10-23"} />
</WidgetLayout>
