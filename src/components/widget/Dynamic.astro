---
import WidgetLayout from "@/components/common/WidgetLayout.astro";
import RecentArticles from "@/components/widget/RecentArticles.svelte";
import type { WidgetComponentConfig } from "@/types/config";

interface Props { class?: string; style?: string; widgetConfig?: WidgetComponentConfig }
const { class: className, style, widgetConfig } = Astro.props;
const limit = Math.max(1, Math.min(10, Math.floor(widgetConfig?.specificConfig?.dynamic?.limit ?? 2)));
---

<WidgetLayout name="最新文章" showTitle={widgetConfig?.showTitle !== false} id="latest-dynamics" class={className} style={style}>
  <RecentArticles client:visible {limit} />
</WidgetLayout>
