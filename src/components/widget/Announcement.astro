---
import WidgetLayout from "@/components/common/WidgetLayout.astro";
import EditableAnnouncement from "@/components/widget/EditableAnnouncement.svelte";
import { announcementConfig } from "@/config/announcementConfig";
import I18nKey from "@/i18n/i18nKey";
import { i18n } from "@/i18n/translation";
import type { WidgetComponentConfig } from "@/types/config";

interface Props { class?: string; style?: string; widgetConfig?: WidgetComponentConfig }
const { class: className, style, widgetConfig } = Astro.props;
---

<WidgetLayout name={announcementConfig.title || i18n(I18nKey.announcement)} showTitle={widgetConfig?.showTitle !== false} id="announcement" class={className} style={style}>
  <EditableAnnouncement client:visible initialContent={announcementConfig.content} />
</WidgetLayout>
