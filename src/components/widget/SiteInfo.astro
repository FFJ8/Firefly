---
import { Icon } from "astro-icon/components";
import WidgetLayout from "@/components/common/WidgetLayout.astro";
import { siteConfig } from "@/config";
import type { WidgetComponentConfig } from "@/types/config";
import pkg from "../../../package.json";

interface Props { class?: string; style?: string; widgetConfig?: WidgetComponentConfig }
const { class: className, style, widgetConfig } = Astro.props;
const domain = new URL(siteConfig.site_url).host;
const builtAt = new Date().toLocaleString("zh-CN", { timeZone: "Asia/Shanghai", hour12: false });
const items = [
  { icon: "material-symbols:cloud-outline", label: "网站托管", value: "Cloudflare Workers" },
  { icon: "material-symbols:language", label: "网站域名", value: domain, href: `https://${domain}` },
  { icon: "mdi:clover", label: "网站程序", value: `Firefly v${pkg.version}` },
  { icon: "material-symbols:build-outline", label: "构建时间", value: builtAt },
  { icon: "fa7-brands:github", label: "项目仓库", value: "FFJ8/Firefly", href: "https://github.com/FFJ8/Firefly" },
];
---

<WidgetLayout name="站点信息" showTitle={widgetConfig?.showTitle !== false} id="site-info" class={className} style={style}>
  <div class="grid gap-2 pb-1">
    {items.map((item) => <div class="flex items-start justify-between gap-2 px-3 py-1.5 text-sm">
      <span class="flex items-center gap-2.5 shrink-0"><Icon name={item.icon} class="text-lg text-(--primary)" aria-hidden="true" />{item.label}</span>
      {item.href ? <a href={item.href} target="_blank" rel="noopener noreferrer" class="min-w-0 break-words text-right text-xs leading-snug font-semibold hover:text-(--primary)" title={item.value}>{item.value}</a>
        : <span class="min-w-0 break-words text-right text-xs leading-snug font-semibold" title={item.value}>{item.value}</span>}
    </div>)}
  </div>
</WidgetLayout>
