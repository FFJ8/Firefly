---
import Live2DWidget from "@components/features/Live2DWidget.astro";

import SpineModel from "@components/features/SpineModel.astro";
import Footer from "@components/layout/Footer.astro";
import HeaderTopRow from "@components/layout/HeaderTopRow.astro";
import NavMenuPanel from "@components/layout/NavMenuPanel.astro";
import SideBar from "@components/layout/SideBar.astro";
import type { MarkdownHeading } from "astro";
import FloatingControls from "@/components/controls/FloatingControls.astro";
import CategoryBar from "@/components/layout/CategoryBar.astro";
import SidebarColumn from "@/components/layout/SidebarColumn.astro";
import WallpaperSection from "@/components/layout/WallpaperSection.astro";
import {
	live2dWidgetConfig,
	navbarMode,
	sidebarLayoutConfig,
	siteConfig,
} from "@/config";
import { getBannerVisibilityState } from "@/utils/banner-visibility-utils";
import { getBackgroundImages, isHomePage } from "@/utils/layout-utils";
import { resolveNavMenuLinks } from "@/utils/nav-menu-utils";
import { getEffectiveSidebarState } from "@/utils/sidebar-effective-utils";
import Layout from "./Layout.astro";

import "@/styles/expressive-code.css";

interface Props {
	title?: string;
	description?: string;
	lang?: string;
	setOGTypeArticle?: boolean;
	postSlug?: string;
	postCoverImage?: string;
	ogImageWidth?: number;
	ogImageHeight?: number;
	ogImageAlt?: string;
	postCategory?: string;
	headings?: MarkdownHeading[];
	encrypted?: boolean;
	bannerPostMeta?: {
		title: string;
		description?: string;
		published: Date;
		updated?: Date;
		words?: number;
		minutes?: number;
	};
	heading?: string;
}

const backgroundImages = getBackgroundImages();

const {
	title,
	description,
	lang,
	setOGTypeArticle,
	postSlug,
	postCoverImage,
	ogImageWidth,
	ogImageHeight,
	ogImageAlt,
	postCategory,
	headings = [],
	encrypted = false,
	bannerPostMeta,
	heading,
} = Astro.props;

const isHomePageCheck = isHomePage(Astro.url.pathname);
const isPostPage = !!postSlug;
const shouldRenderCategoryBar = !!siteConfig.categoryBar;
const navbarWidthFull = siteConfig.navbar.widthFull ?? false;

const banner = getBannerVisibilityState({
	isHomePage: isHomePageCheck,
	isPostPage,
	title,
	bannerPostMeta,
});
const sidebar = getEffectiveSidebarState({ isPostPage });

const { hasWallpaper } = banner;
const {
	hideSidebarOnPostPage,
	hasLeftComponents,
	hasRightComponents,
	sidebarClass,
	staticBarClass,
	gridColumnStyle,
	gridDataAttrs,
} = sidebar;
---

<Layout title={title} description={description} lang={lang} setOGTypeArticle={setOGTypeArticle} postSlug={postSlug} postCoverImage={postCoverImage} ogImageWidth={ogImageWidth} ogImageHeight={ogImageHeight} ogImageAlt={ogImageAlt} hasWallpaper={hasWallpaper}>

<slot slot="head" name="head" />
<HeaderTopRow navbarMode={navbarMode} navbarWidthFull={navbarWidthFull} />

<WallpaperSection state={banner} backgroundImages={backgroundImages} title={title} bannerPostMeta={bannerPostMeta} />

<!-- Main content -->
<div id="content-panel" class="content-panel absolute w-full z-30 pointer-events-none">
    <!-- The pointer-events-none here prevent blocking the click event of the TOC -->
    <div id="content-panel-inner" class="relative w-full xl:w-[92vw] max-w-(--page-width) mx-auto pointer-events-auto" style={gridColumnStyle}>
        {/* 列几何唯一真源 = computeGridColumns()，SSR 写在父级 #content-panel-inner 上
            （页脚作为兄弟节点也要拿到 --content-ratio-*）。子元素无需定位类：
            侧栏包裹层是 display:contents，真正的 grid item 是内层元素 */}
        <div id="main-grid"
          class="transition duration-700 w-full left-0 right-0 grid mx-auto gap-4 px-2 md:px-4 mobile-no-sidebar"
          {...gridDataAttrs}
        >

            <SidebarColumn
                side="left"
                position={sidebarLayoutConfig.position}
                enable={sidebarLayoutConfig.enable}
                hideSidebarOnPostPage={hideSidebarOnPostPage}
                hasLeftComponents={hasLeftComponents}
                hasRightComponents={hasRightComponents}
                sidebarClass={sidebarClass}
                headings={headings}
                encrypted={encrypted}
            />
                    
            {/* 主内容区包装器 - 包含静态栏位和swup容器，作为单个grid item */}
            <div id="content-column" class={staticBarClass}>
                {/* 分类导航栏 - 全站渲染并显示 */}
                {shouldRenderCategoryBar && <div id="category-bar-wrapper"><CategoryBar currentPostCategory={postCategory} /></div>}
                {/* 主内容区 - 始终渲染，确保 Swup 容器存在 */}
                <main
                    id="swup-container"
                    class="transition-main"
                    data-current-post-category={postCategory || ""}
                >
                {/* 为每个页面提供一个隐藏的h1标题，用于SEO和可访问性 */}
                <h1 class="sr-only">{heading || title}</h1>
                <div id="content-wrapper" class="onload-animation transition-leaving" data-pagefind-body>
                    <slot></slot>
                </div>
            </main>

                {/* 移动端底部组件：<768px 时 #main-grid 是 display:block，必须排在页脚之前 */}
            </div>

            <SidebarColumn
                side="right"
                position={sidebarLayoutConfig.position}
                enable={sidebarLayoutConfig.enable}
                hideSidebarOnPostPage={hideSidebarOnPostPage}
                hasLeftComponents={hasLeftComponents}
                hasRightComponents={hasRightComponents}
                sidebarClass={sidebarClass}
                headings={headings}
                encrypted={encrypted}
            />

        </div>

        <SpineModel></SpineModel>
        {live2dWidgetConfig.enable && <Live2DWidget config={live2dWidgetConfig} />}

        {/* 页脚宽度跨「侧栏 + 内容栏」，故在 #content-column 之外；又在 Swup 容器之外，
            切页不重渲染 */}
        <Footer />
    </div>
</div>

<FloatingControls headings={headings} encrypted={encrypted} />

<!-- 移动端导航抽屉：渲染为 <body> 直系子元素，脱离导航栏的 transform 包含块才能铺满视口 -->
<NavMenuPanel links={resolveNavMenuLinks()} />

<div id="mobile-sidebar-backdrop" aria-hidden="true"></div>
<aside id="mobile-sidebar-drawer" aria-label="网站侧栏" aria-hidden="true">
    <div class="mobile-sidebar-content">
        <SideBar side="left" headings={headings} encrypted={encrypted} />
        <SideBar side="right" mobileChronicle headings={headings} encrypted={encrypted} />
    </div>
</aside>
<style is:global>
@media (max-width: 767px) {
  #mobile-sidebar-backdrop { position: fixed; inset: 0; z-index: 89; background: rgba(0,0,0,.42); opacity: 0; visibility: hidden; transition: opacity .25s, visibility .25s; }
  #mobile-sidebar-drawer { position: fixed; inset: 0 auto 0 0; z-index: 90; width: min(82vw, 360px); background: var(--page-bg, #fff); overflow-y: auto; overscroll-behavior: contain; transform: translateX(-105%); transition: transform .28s ease; box-shadow: 8px 0 28px rgba(0,0,0,.16); }
  #mobile-sidebar-drawer .mobile-sidebar-content { display: flex; flex-direction: column; gap: 1rem; padding: max(1rem, env(safe-area-inset-top)) 1rem 2rem; }
  .mobile-chronicle, .mobile-chronicle-group { border-radius: 12px; background: var(--card-bg, rgba(255,255,255,.75)); overflow: hidden; }
  .mobile-chronicle > summary, .mobile-chronicle-group > summary { display: flex; justify-content: space-between; align-items: center; min-height: 48px; padding: .75rem 1rem; color: var(--deep-text); font-weight: 700; cursor: pointer; list-style: none; }
  .mobile-chronicle summary::-webkit-details-marker { display: none; }
  .mobile-chronicle summary span { color: var(--primary); font-size: 1.5rem; line-height: 1; transition: transform .2s; }
  .mobile-chronicle[open] > summary span, .mobile-chronicle-group[open] > summary span { transform: rotate(90deg); }
  .mobile-chronicle-groups { display: grid; gap: .5rem; padding: 0 .5rem .5rem; }
  .mobile-chronicle-group { background: color-mix(in srgb, var(--primary) 7%, transparent); }
  .mobile-chronicle-widget { padding: .25rem .5rem .75rem; }
  html.mobile-sidebar-open #mobile-sidebar-backdrop { opacity: 1; visibility: visible; }
  html.mobile-sidebar-open #mobile-sidebar-drawer { transform: translateX(0); }
  html.mobile-sidebar-open body { overflow: hidden; }
}
@media (min-width: 768px) { #mobile-sidebar-drawer, #mobile-sidebar-backdrop { display: none; } }
</style>
<script is:inline>
(() => {
  if (window.__mobileSidebarGesture) return;
  window.__mobileSidebarGesture = true;
  let startX = 0, startY = 0, tracking = false;
  const drawer = () => document.getElementById('mobile-sidebar-drawer');
  const close = () => { document.documentElement.classList.remove('mobile-sidebar-open'); drawer()?.setAttribute('aria-hidden', 'true'); };
  const open = () => { document.documentElement.classList.add('mobile-sidebar-open'); drawer()?.setAttribute('aria-hidden', 'false'); };
  document.addEventListener('touchstart', e => {
    if (innerWidth >= 768 || e.touches.length !== 1 || document.documentElement.classList.contains('intro-pending')) return;
    startX = e.touches[0].clientX; startY = e.touches[0].clientY;
    tracking = true;
  }, { passive: true });
  document.addEventListener('touchend', e => {
    if (!tracking || !e.changedTouches.length) return;
    tracking = false;
    const dx = e.changedTouches[0].clientX - startX;
    const dy = e.changedTouches[0].clientY - startY;
    if (Math.abs(dx) < 65 || Math.abs(dx) < Math.abs(dy) * 1.3) return;
    if (dx > 0) open(); else close();
  }, { passive: true });
  document.addEventListener('click', e => { if (e.target?.id === 'mobile-sidebar-backdrop' || e.target?.closest?.('#mobile-sidebar-drawer a')) close(); });
  document.addEventListener('keydown', e => { if (e.key === 'Escape') close(); });
  window.addEventListener('resize', () => { if (innerWidth >= 768) close(); });
  const placeCalendar = () => {
    const calendar = document.getElementById('calendar-widget');
    const mount = document.getElementById('mobile-calendar-mount');
    const desktop = document.getElementById('right-sidebar-sticky');
    if (!calendar || !mount || !desktop) return;
    const destination = innerWidth < 768 ? mount : desktop;
    if (calendar.parentElement !== destination) destination.appendChild(calendar);
  };
  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', placeCalendar, { once: true });
  else placeCalendar();
  window.addEventListener('resize', placeCalendar);
})();
</script>

<!--
    触屏设备上让代码块的复制按钮默认隐藏，点一下代码块才显形。
    expressive-code 没给 <pre> 加 tabindex，点击代码区不会产生焦点，
    所以纯 CSS 的 :focus-within 拿不到这个状态，只能在这里补一个类。
    显隐规则见 src/styles/expressive-code.css 的 @media (hover: none) 段。
-->


</Layout>
